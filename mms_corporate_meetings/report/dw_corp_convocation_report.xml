<smartdz>
    <template id="convocation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-foreach="o.participant_ids" t-as="p">
                    <meta charset="utf-8"/>
                    <div style="width:100%; margin:0; padding:0;">
                        <table style="width:100%; table-layout:fixed; border-collapse:collapse;">
                            <tr>
                                <td style="text-align:center;">
                                    <img t-if="o.company_id.logo"
                                         t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-height:120px; max-width:100%;"
                                         alt="Logo"/>
                                </td>
                            </tr>
                            <tr style="border-top:1pt solid #FF0000;">
                                <td colspan="3" style="height:15px;"></td>
                            </tr>
                            <tr>
                                <td style="width:30%;">
                                    <span style="text-decoration: underline;">Ref.</span>
                                    <span>:</span>
                                    <span t-raw="o.meeting_name"></span>
                                </td>
                                <td style="width:40%; text-align:center;"></td>
                                <td style="width:30%; text-align:right;">
                                    <span t-esc="o.company_id.state_id.name"/>
                                    <span>le,</span>
                                    <span t-esc="datetime.date.today().strftime('%d-%m-%Y')"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="page">
                        <br/>
                        <br/>
                        <h4 style="text-align:left">
                            <span style="text-decoration: underline;">Objet :</span>
                            <span t-esc="o.objet or ''"/>
                        </h4>
                        <br/>
                        <table style="width:100%;">
                            <tr style="width:100%;">
                                <td style=" width: 50%;">

                                </td>
                                <td style="width: 50%; font-weight:bold;">

                                    <span t-esc="p.name or ''"/>
                                    <br/>
                                    <t t-if="p.role_id.is_member">
                                        <t t-if="o.meeting_type_id.is_ca">
                                            <span>Membre du Conseil d'administration de</span>
                                        </t>
                                        <t t-elif="o.meeting_type_id.is_ag">
                                            <span>Membre de l'Assemblé Générale de</span>
                                        </t>
                                        <t t-elif="o.meeting_type_id.is_age">
                                            <span>Membre de l'Assemblé Générale Exceptionnelle de</span>
                                        </t>
                                        <br/>
                                        <span t-esc="o.company_id.name"/>
                                    </t>
                                    <br/>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <br/>
                        <table>
                            <tr>
                                <td>
                                    <t t-if="p.employee_id.gender == 'male'">
                                        <span>Monsieur,</span>
                                    </t>
                                    <t t-elif="p.employee_id.gender == 'female'">
                                        <span>Madame,</span>
                                    </t>
                                    <t t-else="">
                                        <span></span>
                                    </t>
                                </td>
                            </tr>
                            <td>
                                <t t-if="o.is_ca">
                                    <span style="white-space: nowrap;">
                                        J'ai l'honneur de vous informer de la prochaine réunion du conseil
                                        d'administration de la
                                    </span>
                                </t>
                                <t t-elif="o.is_ag">
                                    <span style="white-space: nowrap;">
                                        J'ai l'honneur de vous informer de la prochaine assemblée generale de la
                                    </span>
                                </t>
                                <t t-elif="o.is_age">
                                    <span style="white-space: nowrap;">
                                        J'ai l'honneur de vous informer de la prochaine assemblee generale
                                        extraordinaire de la
                                    </span>
                                </t>
                                <t t-else="">
                                    <span style="white-space: nowrap;">
                                        J'ai l'honneur de vous informer de la prochaine reunion
                                    </span>
                                </t>
                                <br/>
                                <span>société qui aura lieu</span>
                                <span t-esc="o.planned_start_datetime or ''"/>
                                <t t-if="p.is_remote">
                                    <span>,a distance,</span>
                                </t>
                                <t t-else="">
                                    <span>,en presentiel,</span>
                                </t>
                                <t t-if="o.is_off_site">
                                    <span>A l'adresse suivante :</span>
                                    <span t-esc="o.location_id.adresse"/>
                                </t>
                                <t t-else="">
                                    <span>au niveau du siege social de la societe.</span>
                                </t>
                            </td>
                        </table>
                        <br/>
                        <br/>
                        <t t-if="o.subject_order">
                            <table style="width:100%;">
                                <tr style="width:100%;">
                                    <td style="width:100%;">
                                        <span>L'ordre du jour est le suivant :</span>
                                    </td>
                                </tr>
                                <t t-foreach="o.subject_order" t-as="s">
                                    <tr>
                                        <td>
                                            <span>-</span>
                                            <span t-esc="s.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </t>
                        <br/>
                        <br/>
                        <table>
                            <tr>
                                <td>
                                    <span>Dans l'attente de vous accueillir, je vous prie d'agreer,</span>
                                    <t t-if="p.employee_id.gender == 'male'">
                                        <span>Monsieur,</span>
                                    </t>
                                    <span>l'expression de ma consideration distinguee.</span>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <br/>
                        <br/>
                        <table style="width:100%;">
                            <tr style="width:100%;">
                                <td style=" width: 50%;">

                                </td>
                                <td style="width: 50%; font-weight:bold; white-space: nowrap;text-decoration: underline;">
                                    <t t-if="o.meeting_type_id.is_ca">
                                        <span style="white-space: nowrap;">LE PRESIDENT DU CONSEIL D'ADMINISTRATION
                                        </span>
                                    </t>
                                    <t t-elif="o.meeting_type_id.is_ag">
                                        <span>LE PRESIDENT DE L'ASSEMBLE GENERALE</span>
                                    </t>
                                    <t t-elif="o.meeting_type_id.is_age">
                                        <span>LE PRESIDENT DE L'ASSEMBLE GENERALE EXCEPTIONNELLE</span>
                                    </t>
                                    <br/>
                                </td>
                            </tr>
                            <tr style="width:100%; height: 200px;">
                                <td style="width: 50%;">
                                </td>
                                <td style="width: 50%; font-weight:bold;text-decoration: underline;text-align:right;">
                                    <span t-esc="o.host_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <br/>
                        <t t-if="o.document_ids">
                            <div style="page-break-inside: avoid;">
                                <table style="width:100%;">
                                    <tr style="width:100%;">
                                        <td style="width:100%;">
                                            <span style="text-decoration: underline; font-weight:bold;">P.J:</span>
                                        </td>
                                    </tr>
                                    <t t-foreach="o.document_ids" t-as="s">
                                        <tr>
                                            <td>
                                                <span>-</span>
                                                <span t-esc="s.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </t>
                        <!-- Optional: force page break after each participant -->
                        <div style="page-break-after: always;"></div>
                    </div>
                    <div class="footer">
                        <div style="font-size: 12px;white-space: nowrap;text-align:center; border-top:1pt solid #FF0000; width:100%;">
                            <span t-esc="o.company_id.street">,</span>
                            <span t-esc="o.company_id.street2">,</span>
                            <span t-esc="o.company_id.city">,</span>
                            <span t-esc="o.company_id.state_id.name">,</span>
                            <span t-esc="o.company_id.zip">,</span>
                            <span>-</span>
                            <span t-esc="o.company_id.country_id.name"/>
                            <br/>
                            <span t-esc="o.company_id.website"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="paperformat_convocation" model="report.paperformat">
        <field name="name">A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">25</field>
        <field name="margin_right">25</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="report_convocation" model="ir.actions.report">
        <field name="name">Convocation</field>
        <field name="model">dw.planification.meeting</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mms_corporate_meetings.convocation_template</field>
        <field name="report_file">mms_corporate_meetings.convocation_template</field>
        <field name="binding_model_id" ref="model_dw_planification_meeting"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="mms_corporate_meetings.paperformat_convocation"/>
    </record>
</smartdz>
