<?xml version="1.0" encoding="UTF-8"?>
<smartdz>
    <!-- Form View -->
    <record id="view_corp_dw_planification_meeting_form" model="ir.ui.view">
        <field name="name">dw.corp.planification.meeting.form</field>
        <field name="model">dw.planification.meeting</field>
        <field name="arch" type="xml">
            <form string="Planification Meeting">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,planned,started,done"/>
                    <button name="action_print_convocations"
                            type="object"
                            string="Print Convocations"
                            class="btn-primary"/>
                    <button name="action_reset_to_draft" string="Set to Draft"
                            type="object"
                            invisible="state in ('cancelled','confirmed','planned','done','draft','started')"
                            class="btn-secondary"/>
                    <button name="action_confirm" string="Confirm"
                            type="object"
                            invisible="state in ('cancelled','planned','done','confirmed','started')"
                            class="btn-primary"/>
                    <button name="action_plan" string="Planify" type="object"
                            invisible="state in ('planned','draft','started','cancelled','done') or not is_current_user_host"
                            class="btn-primary"/>
                    <button name="create_meeting_and_sessions" string="Start" type="object"
                            invisible="state != 'planned' or not is_current_user_host"
                            class="btn-success"/>
                    <button name="action_join" string="Join" type="object"
                            invisible="state != 'started' or not is_current_user_participant"
                            class="btn-primary"/>
                    <button name="action_done" string="Done" type="object"
                            invisible="state in ('done','draft','confirmed','cancelled','planned','started')"
                            class="btn-success"/>
                    <button name="open_meeting" string="Meeting" type="object"
                            invisible="state in ('draft','confirmed','cancelled','planned','started')"
                            class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled','done', 'started') or not is_current_user_host"
                            class="btn-danger"/>
                    <button name="action_postpone" string="Postpone" type="object"
                            invisible="state not in ('planned') or not is_current_user_host"
                            class="btn-warning"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div style="padding:15px; background:#f5f7fa; border-radius:10px; margin-bottom:20px;">
                        <h1 style="font-size:32px; font-weight:bold; color:#1a1a1a; margin-bottom:10px; width:100%;">
                            <field name="name" placeholder="" readonly="state != 'draft'"/>
                        </h1>
                        <h2 style="font-size:25px; font-weight:bold; color:#1a1a1a; margin-bottom:10px; width:100%;">
                            <field name="objet"
                                   readonly="state != 'draft'"
                                   placeholder="Objet"
                                   style="width:100%; min-width:200px;"/>
                        </h2>
                        <div style="display:flex; gap:20px; flex-wrap:wrap;">
                            <div invisible="not is_external"
                                 style="background:#e1f5fe; padding:15px; border-radius:8px; flex:1; min-width:250px;">
                                <strong style="font-size:14px; color:#0277bd; display:block; margin-bottom:8px;">
                                    Client(s):
                                </strong>
                                <div style="width:100%;">
                                    <field name="client_ids"
                                           widget="many2many_tags"
                                           readonly="state != 'draft'"
                                           style="width:100%; min-width:200px;"/>
                                </div>
                            </div>
                            <div style="background:#fff3e0; padding:15px; border-radius:8px; flex:1; min-width:250px;">
                                <strong style="font-size:14px; color:#f57c00; display:block; margin-bottom:8px;">Reunion
                                    Type:
                                </strong>
                                <div style="width:100%;">
                                    <field name="meeting_type_id"
                                           readonly="state != 'draft'"
                                           style="width:100%; min-width:200px;"/>
                                </div>
                            </div>
                            <div style="background:#e8f5e9; padding:15px; border-radius:8px; flex:1; min-width:250px;">
                                <strong style="font-size:14px; color:#388e3c; display:block; margin-bottom:8px;">
                                    Membres Permanents:
                                </strong>
                                <div style="width:100%;">
                                    <field name="permanent_members_id" style="width:100%;"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="planned_start_datetime" readonly="state != 'draft'"/>
                            <field name="tolerated_late" readonly="state != 'draft'"/>
                            <field name="duration" widget="float_time" readonly="state != 'draft'"/>
                            <field name="planned_end_time"/>
                            <field name="times_postponed" readonly="1"/>
                        </group>
                        <group>
                            <field name="location_id" invisible="is_off_site" domain="[('is_in_site', '=', True)]"
                                   readonly="state != 'draft'"/>
                            <field name="location_id" invisible="not is_off_site"
                                   domain="[('is_in_site', '=', False)]" readonly="state != 'draft'"/>
                            <field name="room_id" domain="[('location_id', '=', location_id)]"
                                   readonly="state != 'draft'"/>
                            <field name="equipment_ids" widget="many2many_tags"
                                   invisible="not equipment_ids and state != 'draft'" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="unique_participant_ids" invisible="1" widget="many2many_tags"/>
                            <field name="pv_writer_id2"
                                   invisible="not has_pv or not participant_ids"/>
                            <field name="host_id"
                                   string="Président"
                                   invisible="not participant_ids"/>
                            <field name="quorum" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Members">
                            <field name="member_ids" readonly="state != 'draft'"/>
                        </page>
                        <page string="Guests">
                            <field name="guest_ids" readonly="state != 'draft'"/>
                        </page>

                        <page string="Agenda">
                            <field name="subject_order" nolabel="1" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="duration_minutes" string="Duration (min)"/>
                                </list>
                            </field>
                        </page>

                        <page string="Meeting Outcome" invisible="state not in ('done','cancelled')">
                            <group>
                                <group>
                                    <field name="actual_start_datetime" readonly="1"/>
                                    <field name="actual_end_datetime" readonly="1"/>
                                </group>
                                <group>
                                    <field name="actual_duration" widget="float_time" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="attachments"/>
                                </list>
                            </field>
                        </page>
                        <page string="Options">
                            <group>
                                <group>
                                    <group>
                                        <field name="use_the_chat_room" readonly="state != 'draft'"/>
                                        <field name="sync_with_calendar"/>
                                    </group>
                                    <group>
                                        <field name="is_off_site" readonly="state != 'draft'"/>
                                        <field name="is_presence_constraint"
                                               readonly="state not in ('draft', 'confirmed', 'planned')"/>
                                        <field name="calendar_event_id" invisible="1"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <field name="is_external" readonly="state != 'draft'"/>
                                        <field name="use_vc" readonly="state != 'draft'"/>
                                    </group>
                                    <group>
                                        <field name="has_pv" readonly="state != 'draft'"/>
                                        <field name="is_send_email"
                                               readonly="state not in ('draft','confirmed','planned')"/>
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- list View -->
    <record id="view_corp_dw_planification_meeting_list" model="ir.ui.view">
        <field name="name">dw.corp.planification.meeting.list</field>
        <field name="model">dw.planification.meeting</field>
        <field name="arch" type="xml">
            <list string="Planification Meetings" default_order="planned_start_datetime desc">
                <field name="name"/>
                <field name="meeting_type_id"/>
                <field name="project_id"/>
                <field name="planned_start_datetime"/>
                <field name="planned_end_time"/>
                <field name="duration" widget="float_time"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="dw_corp_ca_planification_meeting_action" model="ir.actions.act_window">
        <field name="name">Planification Meetings</field>
        <field name="res_model">dw.planification.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('meeting_type_id.is_ca', '=', True)]</field>
        <field name="context" eval="{
            'default_meeting_type_id': ref('meeting_management_base.meeting_type_ca'),
            'default_is_ca': True,
            'default_permanent_members_id': ref('mms_corporate_meetings.group_ca'),
            }">
        </field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('view_corp_dw_planification_meeting_list')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('view_corp_dw_planification_meeting_form')})]"/>
    </record>

    <record id="dw_corp_ag_planification_meeting_action" model="ir.actions.act_window">
        <field name="name">Planification Meetings</field>
        <field name="res_model">dw.planification.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('meeting_type_id.is_ag', '=', True)]</field>
        <field name="context" eval="{
            'default_meeting_type_id': ref('meeting_management_base.meeting_type_ag'),
            'default_is_ca': True,
            'default_permanent_members_id': ref('mms_corporate_meetings.group_ag'),
            }">
        </field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('view_corp_dw_planification_meeting_list')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('view_corp_dw_planification_meeting_form')})]"/>
    </record>

    <record id="dw_corp_agex_planification_meeting_action" model="ir.actions.act_window">
        <field name="name">Planification Meetings</field>
        <field name="res_model">dw.planification.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('meeting_type_id.is_age', '=', True)]</field>
        <field name="context" eval="{
            'default_meeting_type_id': ref('meeting_management_base.meeting_type_age'),
            'default_is_ca': True,
            'default_permanent_members_id': ref('mms_corporate_meetings.group_agex'),
            }">
        </field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('view_corp_dw_planification_meeting_list')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('view_corp_dw_planification_meeting_form')})]"/>
    </record>
</smartdz>
