<smartdz>
    <record id="view_corp_dw_permanent_members_tree" model="ir.ui.view">
        <field name="name">dw.corp.permanent.members.tree</field>
        <field name="model">dw.permanent.members</field>
        <field name="arch" type="xml">
            <list string="Permanent Members Groups">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_corp_dw_permanent_members_form" model="ir.ui.view">
        <field name="name">dw.corp.permanent.members.form</field>
        <field name="model">dw.permanent.members</field>
        <field name="arch" type="xml">
            <form string="Permanent Members Group">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_ca"/>
                        <field name="is_ag"/>
                        <field name="is_agex"/>
                    </group>

                    <notebook>
                        <page string="Participants">
                            <field name="participant_ids" context="{'form_view_ref' : 'mms_corporate_meetings.dw_corp_participant_view_form'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_corp_dw_permanent_members" model="ir.actions.act_window">
        <field name="name">Permanent Members Groups</field>
        <field name="res_model">dw.permanent.members</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', '|',('is_ca', '=', True), ('is_ag', '=', True), ('is_agex', '=', True)]</field>
    </record>
</smartdz>