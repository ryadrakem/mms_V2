<smartdz>
    <record id="view_dw_permanent_members_tree" model="ir.ui.view">
        <field name="name">dw.permanent.members.tree</field>
        <field name="model">dw.permanent.members</field>
        <field name="arch" type="xml">
            <list string="Permanent Members Groups">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_dw_permanent_members_form" model="ir.ui.view">
        <field name="name">dw.permanent.members.form</field>
        <field name="model">dw.permanent.members</field>
        <field name="arch" type="xml">
            <form string="Permanent Members Group">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <notebook>
                        <page string="Participants">
                            <field name="participant_ids" context="{'participant_form': 'permanent'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dw_permanent_members" model="ir.actions.act_window">
        <field name="name">Permanent Members Groups</field>
        <field name="res_model">dw.permanent.members</field>
        <field name="view_mode">list,form</field>
    </record>
</smartdz>