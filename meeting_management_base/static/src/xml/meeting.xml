<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="meeting_management_base.MeetingView">
        <div class="dw-meeting-view" role="main">
            <!-- Header -->
            <header class="meeting-header">
                <div class="meeting-header-left">
                    <button class="btn-back" t-on-click="goBack" title="Back">
                        <i class="fa fa-arrow-left"/>
                    </button>
                    <div class="meeting-title-section">
                        <h1 class="meeting-title">
                            <t t-esc="state.meeting.name"/>
                        </h1>
                        <div class="meeting-meta-info">
                            <span class="meta-badge">
                                <i class="fa fa-clock-o"/>
                                <t t-esc="state.meeting.actual_start_datetime"/>
                            </span>
                            <span class="meta-badge">
                                <i class="fa fa-hourglass-half"/>Planned Duration:
                                <t t-esc="state.meeting.duration"/>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="meeting-header-right">
                    <span class="status-chip" t-att-class="state.meeting.state">
                        <span class="status-dot"/>
                        <t t-esc="state.meeting.state.charAt(0).toUpperCase() + state.meeting.state.slice(1).replace('_', ' ')"/>
                    </span>
                </div>
            </header>

            <!-- Content Grid -->
            <div class="meeting-content-grid">
                <!-- Left Sidebar: Participants -->
                <aside class="meeting-sidebar">
                    <div class="sidebar-card">
                        <div class="card-header">
                            <h3>
                                <i class="fa fa-users"/>
                                Participants (<t t-esc="state.meeting.participants?.length"/>)
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="participants-list">
                                <t t-if="state.meeting.participants?.length">
                                    <t t-foreach="state.meeting.participants" t-as="p" t-key="p_index">
                                        <div class="participant-item">
                                            <div class="participant-avatar">
                                                <t t-esc="p.name.slice(0, 2).toUpperCase()"/>
                                                <span t-att-class="'status-badge status-' + (p.attendance_status || 'default')"
                                                      t-att-title="getStatusLabel(p.attendance_status)"
                                                      t-if="state.meeting.state !== 'done'"
                                                />
                                            </div>
                                            <div class="participant-info">
                                                <div class="participant-name">
                                                    <t t-esc="p.name"/>
                                                </div>
                                                <div class="participant-status">
                                                    <t t-if="p.is_late">
                                                        <i class="fa fa-circle text-warning"/> Late
                                                    </t>
                                                    <t t-elif="['present', 'pause'].includes(p.attendance_status)">
                                                        <i class="fa fa-circle text-success"/> Present
                                                    </t>
                                                    <t t-elif="p.attendance_status === 'absent'">
                                                        <i class="fa fa-circle text-danger"/> Absent
                                                    </t>
                                                    <t t-elif="p.attendance_status === 'excused'">
                                                        <i class="fa fa-circle text-muted"/> Excused
                                                    </t>
                                                    <t t-else="">
                                                        <i class="fa fa-circle text-secondary"/> Awaiting
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="empty-participants">
                                        <i class="fa fa-users"/>
                                        <p>No participants</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- Main: Tabbed Content with Navigation -->
                <main class="meeting-main">
                    <!-- Tab Navigation Bar -->
                    <div class="main-tab-navigation">
                        <button
                                class="tab-nav-button"
                                t-att-class="{ 'active': state.activeMainTab === 'agenda' }"
                                t-on-click="() => this.state.activeMainTab = 'agenda'">
                            <i class="fa fa-file-text-o"/>
                            <span>Agenda</span>
                        </button>
                        <button
                                class="tab-nav-button"
                                t-att-class="{ 'active': state.activeMainTab === 'details' }"
                                t-on-click="() => this.state.activeMainTab = 'details'">
                            <i class="fa fa-info-circle"/>
                            <span>Details</span>
                        </button>
                        <button
                                t-if="state.meeting.pv"
                                class="tab-nav-button"
                                t-att-class="{ 'active': state.activeMainTab === 'pv' }"
                                t-on-click="() => this.state.activeMainTab = 'pv'">
                            <i class="fa fa-file-text-o"/>
                            <span>PV</span>
                        </button>
                    </div>

                    <!--agenda section-->
                    <div class="main-tab-content" t-if="state.activeMainTab === 'agenda'">
                        <div class="meeting-actions-section">
                            <div class="actions-header">
                                <h3>
                                    <i class="fa fa-list"/>
                                    Agenda Items
                                </h3>
                            </div>
                            <div class="agenda-body">
                                <t t-if="state.meeting.subject_order?.length">
                                    <t t-foreach="state.meeting.subject_order" t-as="item" t-key="item.id">
                                        <div class="agenda-item">
                                            <div class="agenda-title">
                                                <t t-esc="item.name"/>
                                            </div>
                                            <div class="agenda-description" t-if="item.description">
                                                <t t-esc="item.description"/>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="empty-agenda">
                                        <p>No agenda items</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!--details section-->
                    <div class="main-tab-content" t-if="state.activeMainTab === 'details'">
                        <div class="meeting-actions-section">

                            <div class="actions-header">
                                <h3>
                                    <i class="fa fa-info-circle"/>
                                    Meeting Details
                                </h3>
                            </div>

                            <div class="actions-body">

                                <!-- Actual End -->
                                <div class="info-row" t-if="state.meeting.actual_end_datetime">
                                    <label>Actual End</label>
                                    <span t-esc="state.meeting.actual_end_datetime"/>
                                </div>

                                <!-- Duration -->
                                <div class="info-row" t-if="state.meeting.duration">
                                    <label>Planned Duration</label>
                                    <span>
                                        <t t-esc="state.meeting.duration"/>
                                        hours
                                    </span>
                                </div>

                                <!-- Subject -->
                                <div class="info-row" t-if="state.meeting.objet">
                                    <label>Subject</label>
                                    <span t-esc="state.meeting.objet"/>
                                </div>

                                <!-- Meeting Type -->
                                <div class="info-row" t-if="state.meeting.meeting_type_id">
                                    <label>Type</label>
                                    <span t-esc="state.meeting.meeting_type_id"/>
                                </div>

                                <!-- Planned Start -->
                                <div class="info-row" t-if="state.meeting.planned_start_datetime">
                                    <label>Planned Start</label>
                                    <span t-esc="state.meeting.planned_start_datetime"/>
                                </div>

                                <!-- Planned End -->
                                <div class="info-row" t-if="state.meeting.planned_end_time">
                                    <label>Planned End</label>
                                    <span t-esc="state.meeting.planned_end_time"/>
                                </div>

                                <!-- Actual Start -->
                                <div class="info-row" t-if="state.meeting.actual_start_datetime">
                                    <label>Actual Start</label>
                                    <span t-esc="state.meeting.actual_start_datetime"/>
                                </div>

                                <!-- Actual Duration -->
                                <div class="info-row" t-if="state.meeting.actual_duration">
                                    <label>Actual Duration</label>
                                    <span t-esc="state.formattedDuration"/>
                                </div>

                                <!-- Clients -->
                                <div class="info-row" t-if="state.meeting.client_ids?.length">
                                    <label>Clients</label>
                                    <span>
                                        <t t-foreach="state.meeting.client_ids" t-as="c" t-key="c.id">
                                            <t t-esc="c.name"/>
                                            <t t-if="!loop.last">,</t>
                                        </t>
                                    </span>
                                </div>

                                <!-- Location -->
                                <div class="info-row" t-if="state.meeting.location_id">
                                    <label>Location</label>
                                    <span t-esc="state.meeting.location_id"/>
                                </div>

                                <!-- Room -->
                                <div class="info-row" t-if="state.meeting.room_id">
                                    <label>Room</label>
                                    <span t-esc="state.meeting.room_id"/>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- PV Tab Content -->
                    <div class="main-tab-content" t-if="state.activeMainTab === 'pv'">
                        <div class="meeting-notes-section">
                            <!-- PV Header with Actions -->
                            <div class="notes-header">
                                <div class="pv-header-left">
                                    <h3>
                                        <i class="fa fa-file-text-o"/>
                                        Procès-Verbal (PV)
                                    </h3>
                                    <span class="pv-status-badge" t-att-class="'status-' + state.meeting.pv_status">
                                        <i class="fa fa-circle"/>
                                        <t t-esc="getPvStatusLabel(state.meeting.pv_status)"/>
                                    </span>
                                </div>

                                <!-- PV Actions Toolbar -->
                                <div class="pv-actions">
                                    <!-- Generate Template Button -->
                                    <button class="btn-pv-action"
                                            t-on-click="generatePvTemplate"
                                            t-if="state.meeting.pv_can_edit and !state.meeting.pv"
                                            title="Generate PV Template">
                                        <i class="fa fa-magic"/>
                                        <span>Generate Template</span>
                                    </button>

                                    <!-- Edit/Save Button -->
                                    <button class="btn-pv-action"
                                            t-on-click="togglePvEdit"
                                            t-if="state.meeting.pv_can_edit and !state.pvEditing and state.meeting.pv_status !== 'signed'"
                                            title="Edit PV">
                                        <i class="fa fa-edit"/>
                                        <span>Edit PV</span>
                                    </button>
                                    <button class="btn-pv-action btn-save"
                                            t-on-click="savePv"
                                            t-if="state.meeting.pv_can_edit and state.pvEditing"
                                            title="Save PV">
                                        <i class="fa fa-save"/>
                                        <span>Save PV</span>
                                    </button>

                                    <!-- Download Buttons -->
                                    <button class="btn-pv-action"
                                            t-on-click="downloadPvWord"
                                            t-if="state.meeting.pv"
                                            title="Download as Word">
                                        <i class="fa fa-file-word-o"/>
                                        <span>Word</span>
                                    </button>
                                    <button class="btn-pv-action"
                                            t-on-click="downloadPvPdf"
                                            t-if="state.meeting.pv"
                                            title="Download as PDF">
                                        <i class="fa fa-file-pdf-o"/>
                                        <span>PDF</span>
                                    </button>

                                    <!-- Upload Signed PV Button -->
                                    <button class="btn-pv-action btn-upload"
                                            t-on-click="() => document.getElementById('signed-pv-upload').click()"
                                            t-if="state.meeting.pv_status === 'final' and state.meeting.pv_can_edit"
                                            title="Upload signed PV">
                                        <i class="fa fa-upload"/>
                                        <span>Upload Signed</span>
                                    </button>

                                    <!-- Set Final Button -->
                                    <button class="btn-pv-action btn-final"
                                            t-on-click="setPvFinal"
                                            t-if="state.meeting.pv_can_edit and state.meeting.pv_status === 'draft' and state.meeting.pv"
                                            title="Set PV as Final">
                                        <i class="fa fa-check-circle"/>
                                        <span>Set Final</span>
                                    </button>

                                    <!-- Send PV Button -->
                                    <button class="btn-pv-action btn-send"
                                            t-on-click="sendPvEmails"
                                            t-if="state.meeting.pv and state.meeting.pv_status !== 'draft'"
                                            title="Send PV to participants">
                                        <i class="fa fa-envelope"/>
                                        <span>Send to Participants</span>
                                    </button>

                                    <!-- Finalize Button (only show when file is selected) -->
                                    <button class="btn-pv-action btn-finalize"
                                            t-on-click="uploadSignedPv"
                                            t-if="state.meeting.pv_status === 'final' and state.meeting.pv_can_edit and state.selectedFile"
                                            title="Finalize and close meeting">
                                        <i class="fa fa-check-circle"/>
                                        <span>Finalize</span>
                                    </button>
                                </div>

                                <!-- Hidden file input -->
                                <input type="file"
                                       id="signed-pv-upload"
                                       accept=".pdf,.doc,.docx"
                                       t-on-change="handleFileSelect"
                                       style="display:none;"/>
                            </div>

                            <!-- PV Content Area -->
                            <div class="pv-content-area">
                                <!-- Editable PV -->
                                <div class="notes-editor" t-if="state.pvEditing and state.meeting.pv_can_edit">
                                    <div class="pv-editor-wrapper">
                                        <div
                                            class="pv-html-editor"
                                            contenteditable="true"
                                            t-on-input="onPvInput"
                                            t-ref="pvEditor"
                                        />
                                    </div>
                                </div>

                                <!-- Read-only PV Display -->
                                <div class="pv-display" t-if="!state.pvEditing and state.meeting.pv">
                                    <div class="pv-content" t-out="state.meeting.pv"/>
                                </div>

                                <!-- Empty State -->
                                <div class="pv-empty-state" t-if="!state.meeting.pv">
                                    <i class="fa fa-file-text-o"/>
                                    <p>No PV content yet</p>
                                    <button class="btn-generate-template"
                                            t-on-click="generatePvTemplate"
                                            t-if="state.meeting.pv_can_edit">
                                        <i class="fa fa-magic"/>
                                        Generate PV Template
                                    </button>
                                </div>
                            </div>

                            <!-- PV Info Footer -->
                            <div class="pv-footer">
                                <div class="pv-info">
                                    <span class="info-item" t-if="state.meeting.pv_signed_document_name">
                                        <i class="fa fa-file"/>
                                        Signed file: <strong><t t-esc="state.meeting.pv_signed_document_name"/></strong>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </t>
</templates>